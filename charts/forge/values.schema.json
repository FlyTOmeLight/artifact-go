{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "bootstrap", "artifact", "tenant", "web"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["forge"],
      "properties": {
        "forge": {
          "type": "object",
          "required": ["enabled", "publicURL", "storageEndpoint", "external", "bootstrap"],
          "properties": {
            "enabled": {"const": true},
            "publicURL": {"type": "string", "pattern": "^https?://[^/]+$"},
            "storageEndpoint": {"type": "string", "pattern": "^https?://[^/]+$"},
            "external": {
              "type": "object",
              "required": ["casdoorURL", "issuer", "organization", "certificate", "gitlabURL", "gitlabPublicURL", "gitlabOIDCClientID"],
              "properties": {
                "casdoorURL": {"type": "string", "pattern": "^https?://"},
                "issuer": {"type": "string", "pattern": "^https://"},
                "organization": {"type": "string", "minLength": 1},
                "certificate": {"type": "string", "minLength": 1},
                "gitlabURL": {"type": "string", "pattern": "^https?://"},
                "gitlabPublicURL": {"type": "string", "pattern": "^https?://"},
                "gitlabOIDCClientID": {"type": "string", "minLength": 1},
                "caPEM": {"type": "string"},
                "caSecret": {"type": "string"}
              }
            },
            "bootstrap": {
              "type": "object",
              "required": ["username", "email", "gitlabTokenExpiresAt"],
              "properties": {
                "username": {"type": "string", "minLength": 1},
                "email": {"type": "string", "minLength": 3},
                "gitlabTokenExpiresAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
              }
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "timeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 600}
      }
    },
    "artifact": {"type": "object", "properties": {"fullnameOverride": {"const": ""}, "image": {"$ref": "#/definitions/image"}, "initialization": {"type": "object", "properties": {"enabled": {"const": true}, "storageImage": {"$ref": "#/definitions/image"}}}, "postgres": {"type": "object", "properties": {"existingClaim": {"const": ""}}}}},
    "tenant": {"type": "object", "properties": {"fullnameOverride": {"const": ""}, "image": {"$ref": "#/definitions/image"}, "postgres": {"type": "object", "properties": {"enabled": {"const": true}}}}},
    "juicefs": {"type": "object", "properties": {"fullnameOverride": {"const": ""}, "persistence": {"type": "object", "properties": {"existingClaim": {"const": ""}}}}},
    "web": {
      "type": "object",
      "properties": {
        "image": {"$ref": "#/definitions/image"},
        "coding": {"type": "object", "properties": {"enabled": {"const": false}}},
        "agent": {"type": "object", "properties": {"enabled": {"const": false}}}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    }
  }
}
