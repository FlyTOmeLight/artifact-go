{
  "CORSRules": [
    {
      "AllowedOrigins": ["https://REPLACE_CLIENT_ORIGIN"],
      "AllowedMethods": ["PUT", "POST", "GET", "HEAD", "DELETE"],
      "AllowedHeaders": ["authorization", "content-type", "if-none-match", "x-amz-*"],
      "ExposeHeaders": ["ETag", "x-amz-checksum-sha256", "x-amz-checksum-type", "x-amz-request-id"],
      "MaxAgeSeconds": 300
    }
  ]
}
